# Local REM analysis for Tools/SleepPSG (1 Oct 2026; BACKLOG C): section 9 'features' (per-feature z by PSG stage,
# AUCs, joint logistic REM-vs-light/NREM) and section 10 'remvariants' (REM emission variants per subject), plus
# a RecipeConfig.remClock knob. Apply on a dreamt-psg checkout: git apply <this>; then
#   swift run -c release sleeppsg --dataset <sleep-accel|dreamt> --section features|remvariants
# Result: no REM change survives both datasets (BACKLOG C). Not for upstream as is.
diff --git a/Tools/SleepPSG/Sources/sleeppsg/RecipePort.swift b/Tools/SleepPSG/Sources/sleeppsg/RecipePort.swift
index bf70d4e0..c89bf191 100644
--- a/Tools/SleepPSG/Sources/sleeppsg/RecipePort.swift
+++ b/Tools/SleepPSG/Sources/sleeppsg/RecipePort.swift
@@ -81,6 +81,8 @@ struct RecipeConfig: Equatable {
     var transition: [String: [String: Double]]
 
     // The REM-latency guard (#930) and the sleep-onset rule it is measured from.
+    /// Slope of the REM emission's night-clock ramp (`rem: remClock · clock`). Shipped 1.0.
+    var remClock: Double = 1.0
     var remLatencyPenalty: Double
     var remLatencyMinutes: Double
     var onsetSustainedEpochs: Int
@@ -378,7 +380,7 @@ enum V2Recipe {
 
     static func cyclePrior(_ c: Double, _ minutesSinceOnset: Double, _ cfg: RecipeConfig) -> [String: Double] {
         ["deep": 1.2 * max(0.0, 1.0 - c / 0.55),
-         "rem": 1.0 * c - remLatencyGuard(minutesSinceOnset, cfg),
+         "rem": cfg.remClock * c - remLatencyGuard(minutesSinceOnset, cfg),
          "light": 0.0, "awake": 0.0]
     }
 
diff --git a/Tools/SleepPSG/Sources/sleeppsg/main.swift b/Tools/SleepPSG/Sources/sleeppsg/main.swift
