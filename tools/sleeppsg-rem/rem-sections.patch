     }
 }
 
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────
+// 9. What each feature says about REM (local analysis; both datasets)
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────
+
+if a.section == "features" {
+    print("""
+
+    ================================================================================
+    9. FEATURES AGAINST THE PSG STAGE — what the data supports for REM
+    ================================================================================
+    Per-night z of each emission input (as `stageEpochs` computes it) and the night clock, grouped by the
+    PSG stage of the epoch. AUC = P(value of a random REM epoch > value of a random epoch of the other
+    stage). Then a joint logistic fit, REM against light and REM against all NREM, pooled over subjects,
+    beside the recipe's own REM − light contrast per unit (hr 0.4, hrVar 0.6, move −0.6, resp −respWeight,
+    clock ramp 1.0 per unit of night).
+    """)
+    func zs(_ vals: [Double?]) -> [Double?] {
+        let present = vals.compactMap { $0 }
+        guard !present.isEmpty else { return vals.map { _ in nil } }
+        let m = present.reduce(0, +) / Double(present.count)
+        let sd0 = (present.reduce(0.0) { $0 + ($1 - m) * ($1 - m) } / Double(present.count)).squareRoot()
+        let sd = sd0 == 0 ? 1.0 : sd0
+        return vals.map { $0.map { ($0 - m) / sd } }
+    }
+    let names = ["hr", "hrVar", "move", "resp", "clock"]
+    var byStage = [String: [[Double?]]]()   // stage -> rows of [zhr, zhv, zmv, zrg, clock]
+    for s in subjects {
+        let (feats, _) = V2Recipe.stageEpochsDetailed(start: s.start, end: s.end, grav: s.grav, hr: s.hr, rr: s.rr, resp: [])
+        let zh = zs(feats.map { $0.hr }), zv = zs(feats.map { $0.hrVar })
+        let zm = zs(feats.map { Optional($0.moveFrac) }), zr = zs(feats.map { $0.respReg })
+        for (i, st) in s.truth.enumerated() where i < feats.count {
+            guard let st = st else { continue }
+            byStage[st, default: []].append([zh[i], zv[i], zm[i], zr[i], feats[i].clock])
+        }
+    }
+    print("    feature   mean by PSG stage: wake    light     deep      rem     AUC rem>light  rem>deep  rem>wake")
+    for (j, n) in names.enumerated() {
+        func col(_ st: String) -> [Double] { (byStage[st] ?? []).compactMap { $0[j] } }
+        let r = col("rem")
+        print("    \(n.padding(toLength: 8, withPad: " ", startingAt: 0))\(f(mean(col("wake")), 24, 3))\(f(mean(col("light")), 9, 3))\(f(mean(col("deep")), 9, 3))\(f(mean(r), 9, 3))"
+              + "\(f(aucGreater(r, col("light")), 13, 3))\(f(aucGreater(r, col("deep")), 10, 3))\(f(aucGreater(r, col("wake")), 10, 3))")
+    }
+    let hasResp = (byStage["rem"] ?? []).contains { $0[3] != nil }
+    func fit(_ neg: [String]) -> [Double] {
+        var X: [[Double]] = [], y: [Bool] = []
+        for st in ["rem"] + neg {
+            for row in byStage[st] ?? [] {
+                guard let h = row[0], let v = row[1], let m = row[2] else { continue }
+                var x = [h, v, m]
+                if hasResp { x.append(row[3] ?? 0) }
+                x.append(row[4]!)
+                X.append(x); y.append(st == "rem")
+            }
+        }
+        return Ablation.logisticFit(X: X, y: y)
+    }
+    let shippedContrast = [0.4, 0.6, -0.6, -RecipeConfig.shipped.respWeight, 1.0]
+    for (label, neg) in [("REM vs light", ["light"]), ("REM vs NREM", ["light", "deep"])] {
+        let w = fit(neg)
+        var line = "    joint fit \(label.padding(toLength: 13, withPad: " ", startingAt: 0)) intercept \(f(w[0], 6, 2))"
+        var k = 1
+        for (j, n) in names.enumerated() {
+            if j == 3 && !hasResp { continue }
+            line += "   \(n) \(f(w[k], 6, 2)) (recipe \(f(shippedContrast[j], 5, 2)))"
+            k += 1
+        }
+        print(line)
+    }
+}
+
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────
+// 10. REM emission variants, subject by subject (local analysis; both datasets)
+// ─────────────────────────────────────────────────────────────────────────────────────────────────────
+
+if a.section == "remvariants" {
+    print("\n10. REM EMISSION VARIANTS — per subject against the shipped recipe; stage % pooled; latency = median first-REM min\n")
+    func v(_ name: String, _ edit: (inout RecipeConfig) -> Void) -> (String, RecipeConfig) {
+        var c = RecipeConfig.shipped; edit(&c); return (name, c)
+    }
+    let variants: [(String, RecipeConfig)] = [
+        v("shipped") { _ in },
+        v("hrVar 0.35") { $0.remZhv = 0.35 },
+        v("move -0.25") { $0.remZmv = -0.25 },
+        v("hrVar 0.35, move -0.25") { $0.remZhv = 0.35; $0.remZmv = -0.25 },
+        v("clock 2.0") { $0.remClock = 2.0 },
+        v("clock 1.5") { $0.remClock = 1.5 },
+        v("hrVar .35 move -.25 clock 1.5") { $0.remZhv = 0.35; $0.remZmv = -0.25; $0.remClock = 1.5 },
+        v("hrVar .35 move -.25 clock 2.0") { $0.remZhv = 0.35; $0.remZmv = -0.25; $0.remClock = 2.0 },
+    ]
+    let base = shipped
+    let baseK = base.map { confusion(ref: $0.truth, pred: $0.pred).kappa }
+    func rows(_ idx: [Int], _ label: String) {
+        print("  \(label) (n = \(idx.count))")
+        print("    variant                          pooled κ  mean κ  better/worse  REM F1  |bias| wake deep  REM light   REM/sleep  deep%  latency")
+        for (name, cfg) in variants {
+            let rs = name == "shipped" ? idx.map { base[$0] } : idx.map { score(subjects[$0], using: stageVariant(cfg)) }
+            var c = Confusion(); for r in rs { for i in 0..<r.truth.count { c.add(ref: r.truth[i], pred: r.pred[i]) } }
+            let k = rs.map { confusion(ref: $0.truth, pred: $0.pred).kappa }
+            let bk = idx.map { baseK[$0] }
+            let up = zip(k, bk).filter { $0.0 > $0.1 + 1e-12 }.count, dn = zip(k, bk).filter { $0.0 < $0.1 - 1e-12 }.count
+            let bi = rs.map { stageBias(ref: $0.truth, pred: $0.pred) }
+            func mb(_ st: String) -> Double { mean(bi.map { abs($0[st] ?? 0) }) }
+            let p = pooledPct(rs) { $0.pred }
+            let lat = median(rs.compactMap { firstRemLatencyMinutes($0.fullPred) })
+            print("    \(name.padding(toLength: 32, withPad: " ", startingAt: 0))\(f(c.kappa, 7, 3)) \(f(mean(k), 7, 3))   \(String(up).padding(toLength: 3, withPad: " ", startingAt: 0))/ \(String(dn).padding(toLength: 3, withPad: " ", startingAt: 0))     \(f(c.prf("rem").f1, 5, 3))  "
+                  + "\(f(mb("wake"), 5, 2)) \(f(mb("deep"), 5, 2)) \(f(mb("rem"), 5, 2)) \(f(mb("light"), 5, 2))   \(f(remOfSleepGlobal(rs.flatMap { $0.pred }), 5, 1)) (\(f(remOfSleepGlobal(rs.flatMap { $0.truth }), 4, 1)))  \(f(p["deep"]!, 5, 1))  \(f(lat, 6, 1))")
+        }
+        let tl = median(idx.compactMap { firstRemLatencyMinutes(base[$0].fullTruth) })
+        print("    truth: deep% \(f(pooledPct(idx.map { base[$0] }) { $0.truth }["deep"]!, 5, 1)), first-REM latency median \(f(tl, 5, 1)) min")
+    }
+    let all = Array(subjects.indices)
+    rows(all, "all")
+    if subjects.contains(where: { $0.ahi != nil }) {
+        rows(all.filter { (subjects[$0].ahi ?? 99) < 5 }, "AHI <5")
+    }
+}
+
+/// REM as a share of the SLEEP epochs in `labels` (wake excluded), in percent.
+func remOfSleepGlobal(_ labels: [String]) -> Double {
+    let sleep = labels.filter { $0 != "wake" }.count
+    return sleep == 0 ? .nan : 100 * Double(labels.filter { $0 == "rem" }.count) / Double(sleep)
+}
+
 print("")
